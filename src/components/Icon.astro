---
// Small inline icons (stroke = currentColor, so colour always comes from tokens). Decorative: aria-hidden.
interface Props { name: "phone" | "chat" | "pin" | "chevron" | "menu" | "close" | "arrow"; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3h3.5l1.6 4.4-2.3 1.5a11 11 0 0 0 7.3 7.3l1.5-2.3L21 15.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z" />}
  {name === "chat" && <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5z" />}
  {name === "pin" && <><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === "chevron" && <path d="M6 9l6 6 6-6" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6L6 18" />}
  {name === "arrow" && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
